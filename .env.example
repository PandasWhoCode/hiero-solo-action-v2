# dotenv-linter:off IncorrectDelimiter

# Do not commit your actual .env file to Git! This may contain secrets or other
# private information.

# =============================================================================
# IMPORTANT: Docker Resource Requirements
# =============================================================================
# Before running Solo locally, ensure Docker is configured with:
#   - Memory: At least 12GB
#   - CPUs: At least 4
#   - Disk: At least 60GB
# 
# Configure in Docker Desktop: Settings → Resources
# Or on Linux: Edit /etc/docker/daemon.json and restart Docker
# 
# Verify: docker info | grep -E "(CPUs|Memory)"
# =============================================================================

# Enable/disable step debug logging (default: `false`). For local debugging, it
# may be useful to set it to `true`.
ACTIONS_STEP_DEBUG=true

# GitHub Actions inputs should follow `INPUT_<name>` format (case-sensitive).
# Hyphens in input names should be converted to underscores in environment variables!

# Required: Defines if a mirror node should be installed
INPUT_INSTALLMIRRORNODE=false

# Optional: Version of Hiero consensus node to be used (default: v0.66.0)
INPUT_HIEROVERSION=v0.66.0

# Optional: Version of the mirror node to be used (default: v0.138.0)
INPUT_MIRRORNODEVERSION=v0.138.0

# Optional: Port for Mirror Node REST API (default: 5551)
INPUT_MIRRORNODEPORTREST=5551

# Optional: Port for Mirror Node gRPC (default: 5600)
INPUT_MIRRORNODEPORTGRPC=5600

# Optional: Port for Mirror Node WEB3 REST (default: 8545)
INPUT_MIRRORNODEPORTWEB3REST=8545

# Optional: Install JSON-RPC-Relay (default: false)
INPUT_INSTALLRELAY=false

# Optional: Port for JSON-RPC-Relay (default: 7546)
INPUT_RELAYPORT=7546

# Optional: Port for gRPC Proxy (default: 9998)
INPUT_GRPCPROXYPORT=9998

# Optional: Port for HAProxy (default: 50211)
INPUT_HAPROXYPORT=50211

# Optional: Version of Solo CLI to install (default: 0.46.1)
INPUT_SOLOVERSION=0.46.1

# Optional: Port for Java-based REST API (default: 8084)
INPUT_JAVARESTIAPIPORT=8084

# Optional: Amount of HBAR to be assigned to the created accounts (default: 10000000)
INPUT_HBARAMOUNT=10000000

# GitHub Actions default environment variables (uncomment and set as needed for local testing)
# https://docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables

# CI="true"
# GITHUB_ACTIONS="true"
# GITHUB_WORKSPACE="/home/runner/work/hiero-solo-action-v2/hiero-solo-action-v2"
# RUNNER_TEMP="/tmp"
# RUNNER_TOOL_CACHE="/opt/hostedtoolcache"
